{
  "manifest_version": 3,
  "name": "Twitter Fixer",
  "version": "0.1.1",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "css": [
        "features/hide.css",
        "sidebar/button.css",
        "settings/page.css",
        "features/align.css",
        "features/quotes.css",
        "features/pin.css",
        "features/header.css"
      ],
      "js": [
        "icons.js",
        "settings/data.js",
        "settings/page.js",
        "sidebar/button.js",
        "features/hide.js",
        "features/align.js",
        "features/header.js",
        "features/menu.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "sidebar/unselect.js",
        "features/all.js",
        "features/quotes.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
